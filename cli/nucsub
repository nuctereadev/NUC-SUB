print_header() {
    clear
    echo -e "${BOLD}${CYAN}"
    echo "  ███████╗███████╗██╗   ██╗██╗   ██╗    ███████╗██████╗ ██████╗ ███████╗"
    echo "  ██╔════╝██╔════╝██║   ██║██║   ██║    ██╔════╝██╔══██╗██╔══██╗██╔════╝"
    echo "  █████╗  ███████╗██║   ██║██║   ██║    █████╗  ██████╔╝██████╔╝███████╗"
    echo "  ██╔══╝  ╚════██║██║   ██║██║   ██║    ██╔══╝  ██╔══██╗██╔══██╗╚════██║"
    echo "  ██║     ███████║╚██████╔╝╚██████╔╝    ██║     ██║  ██║██║  ██║███████║"
