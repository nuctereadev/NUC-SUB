# --------------------------------------------------------------- commands ----
cmd_list() {
    title "Installed Themes"; sep
    local current
    current="$(basename "$(current_theme_dir 2>/dev/null)" 2>/dev/null || true)"
    [[ -n "$current" && "$current" == "." ]] && current=""
    local t tag
    while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        tag="   "
        [[ "$t" == "$current" ]] && tag="${GREEN} ★${NC}"
        if theme_is_runnable "$t"; then
            printf "${tag}  %-16s %b\n" "$t" "${GREEN} downloaded${NC}"
        else
            printf "${tag}  %-16s %b\n" "$t" "${YELLOW} not downloaded${NC}"
        fi
    done < <(available_themes)
    if [[ -n "$current" ]]; then
        echo ""; ok "Active: $current"
    else
        echo ""; info "No custom theme set — panel uses built-in default."
    fi
    echo -e "${DIM}  Running 'nucsub apply' downloads a theme automatically.${NC}"
}

cmd_apply() {
    require_root
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        local themes=()
        while IFS= read -r t; do [[ -n "$t" ]] && themes+=("$t"); done < <(available_themes)
        [[ ${#themes[@]} -eq 0 ]] && { fail "No themes available."; return 1; }
        title "Select theme to apply"; sep
        select t in "${themes[@]}" "Cancel"; do
            [[ "$REPLY" -ge 1 && "$REPLY" -le ${#themes[@]} ]] && { name="${themes[$((REPLY-1))]}"; break; }
            [[ "$REPLY" -eq $(( ${#themes[@]} + 1 )) ]] && { info "Cancelled."; return 0; }
            warn "Invalid selection."
        done
    fi
    valid_theme_name "$name" || { fail "Invalid theme name: '$name'"; return 1; }

    # Download (if needed). Fail loudly but non-fatally so the menu survives.
    download_theme "$name" || { fail "Failed to download theme '$name' ($REPO_URL)."; return 1; }

    if [[ "$PANEL" == "pasarguard" ]]; then
        [[ -s "$PG_THEMES_DIR/$name.html" ]] || { fail "Theme '$name' not found or empty."; return 1; }
        validate_download "$PG_THEMES_DIR/$name.html" || { fail "Theme '$name' source is invalid."; return 1; }
        mkdir -p "$PG_TEMPLATES_DIR"
        if ! cp -f "$PG_THEMES_DIR/$name.html" "$PG_TEMPLATES_DIR/$name.html"; then
            fail "Could not copy theme '$name' into $PG_TEMPLATES_DIR/."
            return 1
        fi
        chmod -R a+rX "$PG_TEMPLATES_DIR/$name.html"
        pg_inject_tg "$PG_TEMPLATES_DIR/$name.html"
        # The panel shows the admin's own sub_template live (no restart needed
        # when the DB/API is reachable). Restart only as a fallback so the .env
        # default is picked up.
        local env_ok=0 sync_ok=0
        pg_env_apply "$name" && env_ok=1 || true
        pg_sync "$name" && sync_ok=1 || true
        # Restart the panel ONLY when its live SUBSCRIPTION_PAGE_TEMPLATE doesn't
        # already match the .env we just wrote (avoids downtime on every apply).
        if [[ $env_ok -eq 1 ]] && ! pg_env_effective "$name"; then
            pg_restart_panel || warn "Panel restart failed — run it manually later."
        fi
        if [[ $sync_ok -eq 1 ]]; then
            ok "Theme '$name' deployed and activated ($PG_TEMPLATES_DIR/$name.html)"
        elif [[ $env_ok -eq 1 ]]; then
            ok "Theme '$name' deployed and activated via .env ($PG_TEMPLATES_DIR/$name.html)"
        else
            warn "Theme copied to $PG_TEMPLATES_DIR/$name.html"
            warn "Activation needs the panel .env (PASARGUARD_ENV) or working DB access."
        fi
        # The loader only resolves <CUSTOM_TEMPLATES_DIRECTORY>/subscription/<name>.html
        # and app/templates/subscription/<name>.html — if the file does not land where
        # the running panel can read it, the subscription page will 500. Verify now.
        if ! pg_verify_deploy "$name"; then
            warn "Trying a built-in copy repair so the theme still renders..."
            if pg_repair_builtin_copy "$name" && pg_verify_deploy "$name"; then
                ok "Theme '$name' now renders from the panel's own template dir."
            else
                warn "The theme may still return 500 until this is fixed on the box. Run: nucsub pg-diagnose"
                warn "The file must be readable by the panel at: $(pg_theme_host_file "$name")"
            fi
        fi
        return 0
    fi
    local src="$THEMES_DIR/$name"
    [[ -d "$src" ]] || { fail "Theme '$name' not found."; return 1; }
    theme_is_runnable "$name" || { fail "Theme '$name' has no (non-empty) index.html/sub.html."; return 1; }
    validate_download "$THEMES_DIR/$name/index.html" || { fail "Theme '$name' source is invalid."; return 1; }

    # Atomic-ish deploy: copy into a temp staging dir and swap in only after a
    # successful copy + validation, so a half-copied theme never reaches deploy.
    local stage="$DEPLOY_DIR/.$name.staging"
    mkdir -p "$DEPLOY_DIR"
    rm -rf "$stage"
    if ! mkdir -p "$stage" || ! cp -r "$src"/. "$stage/"; then
        rm -rf "$stage"
        fail "Could not stage theme '$name' for deploy."
        return 1
    fi
    chmod -R a+rX "$stage"

    # inject Telegram channel placeholder from config into deployed theme
    if [[ -f "$stage/index.html" ]]; then
        local tg
        tg="$(config_get telegram_channel)"
        python3 - "$stage/index.html" "$tg" <<'PY'
import sys
p,chan=sys.argv[1],sys.argv[2]
s=open(p,encoding='utf-8').read()
s=s.replace('@@TG_CHANNEL@@',chan)
open(p,'w',encoding='utf-8').write(s)
PY
    fi

    if [[ ! -s "$stage/index.html" ]]; then
        rm -rf "$stage"
        fail "No valid index.html staged for '$name' — deploy aborted."
        return 1
    fi
    # as a final safety check, re-inject from pristine source too (inject_tg does)
    if [[ -f "$THEMES_DIR/$name/index.html" ]]; then
        inject_tg "$THEMES_DIR/$name/index.html" "$stage/index.html" || true
    fi

    # atomic swap
    rm -rf "$DEPLOY_DIR/$name"
    if ! mv "$stage" "$DEPLOY_DIR/$name"; then
        fail "Deploy move failed for '$name' — panel NOT changed."
        return 1
    fi
    chmod -R a+rX "$DEPLOY_DIR/$name"

    if [[ -f "$DEPLOY_DIR/$name/index.html" ]] && [[ -s "$DEPLOY_DIR/$name/index.html" ]]; then
        db_set_subthemedir "$DEPLOY_DIR/$name" || { fail "Could not set subThemeDir."; return 1; }
        ok "Theme '$name' deployed to $DEPLOY_DIR/$name"
    else
        fail "Deploy incomplete (no index.html at $DEPLOY_DIR/$name/index.html) — panel NOT changed."
        return 1
    fi

    # Restart the panel; report failure but never crash the caller.
    if systemctl list-unit-files "$XUI_SERVICE.service" >/dev/null 2>&1; then
        if systemctl restart "$XUI_SERVICE" >/dev/null 2>&1; then
            ok "Panel restarted."
        else
            warn "Panel restart failed — theme is deployed, but the panel may not have reloaded it yet."
            warn "Run 'systemctl restart $XUI_SERVICE' manually, or re-run this apply."
        fi
    elif command -v "$XUI_SERVICE" >/dev/null 2>&1; then
        "$XUI_SERVICE" restart >/dev/null 2>&1 || warn "Panel restart failed (systemctl not used)."
    fi
    return 0
}

cmd_reset() {
    require_root
    if [[ "$PANEL" == "pasarguard" ]]; then
        if pg_env_apply "__builtin__"; then
            pg_sync "" || true
            pg_restart_panel || warn "Panel restart failed — run it manually later."
            ok "Pasarguard back to the built-in default subscription page."
        else
            warn "Panel .env not found — open the panel .env and set SUBSCRIPTION_PAGE_TEMPLATE=subscription/index.html"
        fi
        return 0
    fi
    db_set_subthemedir "" || { fail "Could not clear subThemeDir."; return 1; }
    ok "subThemeDir cleared — panel back to built-in default."
    if systemctl list-unit-files "$XUI_SERVICE.service" >/dev/null 2>&1; then
        if systemctl restart "$XUI_SERVICE" >/dev/null 2>&1; then
            ok "Panel restarted."
        else
            warn "Panel restart failed — run 'systemctl restart $XUI_SERVICE' later."
        fi
    elif command -v "$XUI_SERVICE" >/dev/null 2>&1; then
        "$XUI_SERVICE" restart >/dev/null 2>&1 || warn "Panel restart failed (systemctl not used)."
    fi
    return 0
}

cmd_remove() {
    require_root
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        local themes=()
        while IFS= read -r t; do [[ -n "$t" ]] && themes+=("$t"); done < <(list_theme_folders)
        [[ ${#themes[@]} -eq 0 ]] && { fail "No themes installed."; return 1; }
        title "Select theme to remove"; sep
        select t in "${themes[@]}" "Cancel"; do
            [[ "$REPLY" -ge 1 && "$REPLY" -le ${#themes[@]} ]] && { name="${themes[$((REPLY-1))]}"; break; }
            [[ "$REPLY" -eq $(( ${#themes[@]} + 1 )) ]] && { info "Cancelled."; return 0; }
            warn "Invalid selection."
        done
    fi
    valid_theme_name "$name" || { fail "Invalid theme name: '$name'"; return 1; }
    if [[ "$PANEL" == "pasarguard" ]]; then
        [[ -s "$PG_THEMES_DIR/$name.html" ]] || { fail "Theme '$name' not found."; return 1; }
        rm -f "$PG_TEMPLATES_DIR/$name.html" "$PG_THEMES_DIR/$name.html"
        if [[ "$(current_theme_dir)" == "$name" ]]; then
            warn "Theme '$name' was active — panel returns to default."
            pg_env_apply "__builtin__" || true
            pg_sync "" || true
            pg_restart_panel || warn "Panel restart failed — run it manually later."
        fi
        ok "Removed theme '$name'."
        return 0
    fi
    [[ -d "$THEMES_DIR/$name" ]] || { fail "Theme '$name' not found."; return 1; }
    local cur
    cur="$(basename "$(current_theme_dir 2>/dev/null)" 2>/dev/null || true)"
    if [[ "$cur" == "$name" ]]; then
        warn "Theme '$name' is active — panel will return to default."
        db_set_subthemedir "" || true
    fi
    rm -rf "$THEMES_DIR/$name" "$DEPLOY_DIR/$name"
    ok "Removed theme '$name'."
    if systemctl list-unit-files "$XUI_SERVICE.service" >/dev/null 2>&1; then
        systemctl restart "$XUI_SERVICE" >/dev/null 2>&1 || warn "Panel restart failed."
    fi
    return 0
}

cmd_download() {
    require_root
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        local themes=()
        while IFS= read -r t; do [[ -n "$t" ]] && themes+=("$t"); done < <(available_themes)
        title "Select theme to download"; sep
        select t in "${themes[@]}" "Cancel"; do
            [[ "$REPLY" -ge 1 && "$REPLY" -le ${#themes[@]} ]] && { name="${themes[$((REPLY-1))]}"; break; }
            [[ "$REPLY" -eq $(( ${#themes[@]} + 1 )) ]] && { info "Cancelled."; return 0; }
            warn "Invalid selection."
        done
    fi
    valid_theme_name "$name" || { fail "Invalid theme name: '$name'"; return 1; }
    if theme_is_runnable "$name"; then
        info "Theme '$name' is already downloaded."
        return 0
    fi
    download_theme "$name" || { fail "Failed to download theme '$name' ($REPO_URL)."; return 1; }
    ok "Theme '$name' downloaded — use 'nucsub apply $name' to activate it."
}

