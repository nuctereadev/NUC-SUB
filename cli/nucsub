# ----------------------------------------------------------- Web panel mgmt ---
web_panel_status() {
    local up="" port="" token=""
    if [[ -f "$INSTALL_DIR/.webpanel.pid" ]] && kill -0 "$(cat "$INSTALL_DIR/.webpanel.pid")" 2>/dev/null; then
        up=1
    elif systemctl is-active --quiet "$WEB_SERVICE" 2>/dev/null; then
        up=1
    elif pgrep -f "server\.py" >/dev/null 2>&1; then
        up=1
    fi
    if [[ -n "$up" ]]; then
        port="$(cat "$WEB_PORT_FILE" 2>/dev/null || true)"
        if [[ -z "$port" ]]; then
            port="$(ss -tlnp 2>/dev/null | grep 'python3' | grep -oE ':[0-9]{2,5}' | head -n1 | tr -d ':')"
            [[ -z "$port" ]] && port="8080"
        fi
        token="$(cat "$WEB_TOKEN_FILE" 2>/dev/null || echo "unknown")"
        echo -e "  ${GREEN}● Running${NC} on port $port"
        echo -e "  ${DIM}  Token: $token${NC}"
        return 0
    else
        echo -e "  ${RED}● Stopped${NC}"
        return 1
    fi
}

# Detect the server's primary outbound IPv4 so the printed login URL is usable
# (never 0.0.0.0 unless nothing else is available).
web_panel_host() {
    local h="${SUB_PANEL_HOST:-}"
    if [[ -n "$h" && "$h" != "0.0.0.0" ]]; then echo "$h"; return 0; fi
    h=""
    if command -v ip >/dev/null 2>&1; then
        h="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \([0-9.]\{7,15\}\).*/\1/p')" || true
    fi
    if [[ -z "$h" ]] && command -v hostname >/dev/null 2>&1; then
        h="$(hostname -I 2>/dev/null | awk '{print $1}')" || true
    fi
    [[ -z "$h" ]] && h="0.0.0.0"
    echo "$h"
}

# Install the web panel as a real systemd service (survives reboots/reinstalls).
# Returns 0 only when systemd accepted it; callers fall back to a nohup process.
# Secrets live in a root-only EnvironmentFile, never in the (world-readable)
# unit body; the service gets basic hardening for the public-facing HTTP server.
web_panel_install_service() {
    local port="${1:-}" token="$2" dbpath="${3:-}" unit="$WEB_SERVICE.service" uroot="" py="" envf="$INSTALL_DIR/.webpanel-env"
    command -v systemctl >/dev/null 2>&1 || return 1
    if [[ -d /etc/systemd/system ]]; then uroot="/etc/systemd/system"
    elif [[ -d /usr/lib/systemd/system ]]; then uroot="/usr/lib/systemd/system"
    else return 1; fi
    py="$(command -v python3 || echo /usr/bin/python3)"
    # only pass --db when a real path exists (Pasarguard installs have none)
    local dbaro=""
    [[ -n "$dbpath" && -e "$dbpath" ]] && dbaro="--db $dbpath"
    umask 077
    cat > "$envf" <<EOF
NP_PORT=$port
NP_TOKEN=$token
NP_BASE=$WEB_BASE
NP_CLI=$INSTALL_DIR/cli/nucsub
NP_THEMES=$THEMES_DIR
EOF
    chmod 600 "$envf"
    cat > "$uroot/$unit" <<EOF
[Unit]
Description=NUC-SUB web panel (subscription theme manager)
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=-$envf
ExecStart=$py $WEB_BASE/server.py --port \${NP_PORT} --token \${NP_TOKEN} --base \${NP_BASE} --cli \${NP_CLI} --themes \${NP_THEMES} $dbaro
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
    chmod 600 "$uroot/$unit"
    systemctl daemon-reload >/dev/null 2>&1 || return 1
    systemctl enable "$WEB_SERVICE" >/dev/null 2>&1 || true
    systemctl restart "$WEB_SERVICE" >/dev/null 2>&1 && systemctl is-active --quiet "$WEB_SERVICE" || return 1
    return 0
}

cmd_webpanel() {
    local action="${1:-status}"
    case "$action" in
        start)
            require_root
            if web_panel_status | grep -q "Running"; then warn "Already running."; return; fi
            # Auto-install missing web panel assets so start always works.
            if [[ ! -f "$WEB_BASE/server.py" ]]; then
                info "Web panel files missing — installing from GitHub..."
                mkdir -p "$WEB_BASE"
                local _wf
                for _wf in "webpanel/server.py" "webpanel/index.html" "webpanel/css/icons.css" "webpanel/css/fonts.css" "webpanel/css/panel.css" "webpanel/fonts/IRANSansX-Bold.woff2" "webpanel/fonts/IRANSansX-Regular.woff2" "webpanel/fa/fa-solid-900.woff2"; do
                    mkdir -p "$INSTALL_DIR/$(dirname "$_wf")"
                    curl -fsSL -m 40 "$REPO_URL/$_wf" -o "$INSTALL_DIR/$_wf" || warn "Failed to fetch $_wf"
                done
            fi
            local port="${SUB_PANEL_PORT:-8080}"
            [[ "$port" =~ ^[0-9]{1,5}$ ]] || { warn "Ignoring invalid SUB_PANEL_PORT='$port' — using 8080."; port=8080; }
            # smart port selection: if the requested/free port is occupied, pick the next free one
            if ! ss -tlnp 2>/dev/null | grep -q ":${port} "; then
                : # port free
            else
                port="$(find_free_port "$((port+1))" 100)"
                warn "Port ${SUB_PANEL_PORT:-8080} occupied — using $port"
            fi
            local token=""
            if [[ -f "$WEB_TOKEN_FILE" ]]; then
                token="$(<"$WEB_TOKEN_FILE")"
                # if the stored token is corrupted or contains special characters, regenerate
                [[ "$token" =~ ^[A-Za-z0-9]{16,64}$ ]] || token=""
            fi
            if [[ -z "$token" ]]; then
                token="$(head -c 32 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c 32)"
                echo "$token" > "$WEB_TOKEN_FILE"
                chmod 600 "$WEB_TOKEN_FILE"
            fi
            echo "$port" > "$WEB_PORT_FILE"
            if ! command -v python3 >/dev/null 2>&1; then die "python3 required (install it first: apt install -y python3)."; fi
            local dbpath=""
            [[ "$PANEL" == "3xui" ]] && dbpath="$XUI_DB"
            # prefer a real systemd service (auto-start on boot); nohup is the fallback
            if web_panel_install_service "$port" "$token" "$dbpath"; then
                ok "Web panel started (systemd $WEB_SERVICE) on port $port"
            else
                warn "systemd unavailable — starting in background (no auto-start on boot)..."
                nohup python3 "$WEB_BASE/server.py" --port "$port" --token "$token" --base "$WEB_BASE" \
                     --cli "$INSTALL_DIR/cli/nucsub" --themes "$THEMES_DIR" --db "$dbpath" \
                     >"$INSTALL_DIR/webpanel.log" 2>&1 &
                echo $! > "$INSTALL_DIR/.webpanel.pid"
                sleep 1
                if web_panel_status | grep -q "Running"; then
                    ok "Web panel started on port $port"
                else
                    warn "Start failed — check $INSTALL_DIR/webpanel.log"
                    tail -n 5 "$INSTALL_DIR/webpanel.log" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | while IFS= read -r line; do warn "$line"; done
                    return 1
                fi
            fi
            echo ""
            echo -e "  ${CYAN}Login URL : ${BOLD}http://$(web_panel_host):$port/${NC}"
            echo -e "  ${CYAN}Token     : ${YELLOW}$token${NC}"
            echo -e "  ${DIM}Use this token on the login page to enter the panel.${NC}"
            ;;
        stop)
            require_root
            systemctl stop "$WEB_SERVICE" 2>/dev/null || true
            systemctl disable "$WEB_SERVICE" 2>/dev/null || true
            if [[ -f "$INSTALL_DIR/.webpanel.pid" ]]; then
                kill "$(cat "$INSTALL_DIR/.webpanel.pid")" 2>/dev/null || true
                rm -f "$INSTALL_DIR/.webpanel.pid"
            fi
            pkill -f "python3.*server.py.*--port" 2>/dev/null || true
            ok "Web panel stopped."
            ;;
        restart)
            require_root
            cmd_webpanel stop; sleep 1; cmd_webpanel start
            ;;
        status)
            title "Web Panel Status"; sep
            web_panel_status || true
            ;;
        token)
            [[ -f "$WEB_TOKEN_FILE" ]] && cat "$WEB_TOKEN_FILE" || warn "No token file."
            ;;
        *)
            echo -e "${YELLOW}Usage: nucsub webpanel {start|stop|restart|status|token}${NC}"
            ;;
    esac
}

# ------------------------------------------------------------- Web panel menu ---
web_panel_menu() {
    while true; do
        clear
        print_header
        title "Web Panel Management"
        sep
        web_panel_status || true
        sep
        echo -e "  ${GREEN}1)${NC} Start web panel        ${DIM}— install + run + show URL/token${NC}"
        echo -e "  ${GREEN}2)${NC} Stop web panel"
        echo -e "  ${GREEN}3)${NC} Restart web panel"
        echo -e "  ${GREEN}4)${NC} Show token"
        echo -e "  ${GREEN}5)${NC} Telegram channel       ${DIM}— set / edit / delete the channel link (shown in themes)${NC}"
        echo -e "  ${GREEN}0)${NC} Back to main menu"
        sep
        echo -ne "  ${BOLD}Select option [0-5]: ${NC}"
        read -r choice
        case "$choice" in
            1) cmd_webpanel start; pause_enter ;;
            2) cmd_webpanel stop; pause_enter ;;
            3) cmd_webpanel restart; pause_enter ;;
            4) title "Web Panel Token"; sep; cmd_webpanel token; pause_enter ;;
            5) telegram_menu ;;
            0) return ;;
            *) warn "Invalid option: $choice"; sleep 1 ;;
        esac
    done
}

telegram_menu() {
    while true; do
        clear
        print_header
        title "Telegram Channel"
        sep
        echo -e "  ${DIM}Current channel:${NC}"
        cmd_telegram get
        sep
        echo -e "  ${GREEN}1)${NC} Set / change channel"
        echo -e "  ${GREEN}2)${NC} Delete channel (remove the link from themes)"
        echo -e "  ${GREEN}0)${NC} Back to web panel menu"
        sep
        echo -ne "  ${BOLD}Select option [0-2]: ${NC}"
        read -r choice
        case "$choice" in
            1) cmd_telegram set; pause_enter ;;
            2) cmd_telegram clear; pause_enter ;;
            0) return ;;
            *) warn "Invalid option: $choice"; sleep 1 ;;
        esac
