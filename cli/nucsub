reapply_active() {  # re-inject telegram channel + brand tokens into the active theme
    local cur
    if [[ "$PANEL" == "pasarguard" ]]; then
        cur="$(pg_current_theme)"
        [[ -n "$cur" && -f "$PG_THEMES_DIR/$cur.html" ]] || return 0
        cp -f "$PG_THEMES_DIR/$cur.html" "$PG_TEMPLATES_DIR/$cur.html"
        pg_inject_tg "$PG_TEMPLATES_DIR/$cur.html"
        return 0
    fi
    cur="$(basename "$(current_theme_dir 2>/dev/null)" 2>/dev/null || true)"
    [[ -n "$cur" && -f "$THEMES_DIR/$cur/index.html" ]] || return 0
    inject_tg "$THEMES_DIR/$cur/index.html" "$DEPLOY_DIR/$cur/index.html"
}

cmd_refresh() {  # re-apply stored telegram/brand settings into the active theme (no data change)
    require_root
    reapply_active
    ok "Active theme re-synced from shared settings."
}

cmd_telegram() {
    local action="${1:-get}"
    local val
    case "$action" in
        get|show)
            val="$(config_get telegram_channel)"
            if [[ -n "$val" ]]; then echo "$val"
            else warn "No Telegram channel set."; fi
            ;;
        set)
            require_root
            val="${2:-}"
            if [[ -z "$val" ]]; then
                echo -ne "  Telegram channel URL (https://t.me/...): "
                read -r val
            fi
            [[ -z "$val" ]] && fail "No URL provided."
            if [[ ! "$val" =~ ^https://t\.me/[A-Za-z0-9_]{5,}$ ]]; then
                fail "Invalid Telegram URL — expected: https://t.me/username"
            fi
            config_set telegram_channel "$val"
            ok "Telegram channel set: $val"
            reapply_active
            ;;
        clear|unset)
            require_root
            config_set telegram_channel ""
            ok "Telegram channel cleared."
            reapply_active
            ;;
        *)
            echo -e "${YELLOW}Usage: nucsub telegram {get|set <url>|clear}${NC}"
            ;;
    esac
}

# --------------------------------------------------------------- Branding cmd ---
cmd_brand() {
    local action="${1:-get}"
    local val
    case "$action" in
        get|show)
            val="$(config_get brand_name)"
            if [[ -n "$val" ]]; then echo -e "  Brand name: ${BOLD}$val${NC}"
            else echo "  No brand name set."; fi
            val="$(config_get brand_logo)"
            if [[ -n "$val" ]]; then echo "  Brand logo: ${GREEN}set${NC} ($((${#val}/1024)) KiB data URL)"
            else echo "  Brand logo: not set."; fi
            ;;
        set-logo-data)
            require_root
            val="${2:-}"
            [[ -n "$val" ]] || fail "No logo data URL provided."
            [[ "$val" == data:image/* ]] || fail "Logo must be a data:image URL."
            local _b64 _hex
            _b64="${val#*,}"
            _hex="$(printf '%s' "$_b64" | base64 -d 2>/dev/null | head -c 12 | od -An -tx1 | tr -d ' \n')"
            case "$_hex" in
                89504e470d0a1a0a*|ffd8ff*|474946383761*|474946383961*|52494646*57454250) : ;;
                *) fail "Logo data is not a real PNG/JPEG/GIF/WebP image (refused)." ;;
            esac
            [[ "${#val}" -le 1050000 ]] || fail "Logo too large (max ~1 MiB)."
            config_set brand_logo "$val"
            ok "Brand logo set (${#val} chars)."
            reapply_active
            ;;
        clear-logo)
            require_root
            config_set brand_logo ""
            ok "Brand logo cleared."
            reapply_active
            ;;
        set|set-name)
            require_root
            val="${2:-}"
            if [[ -z "$val" ]]; then
                echo -ne "  Brand name: "
                read -r val
            fi
            [[ -z "$val" ]] && fail "No brand name provided."
            if [[ "${#val}" -gt 30 ]]; then
                fail "Brand name too long — max 30 characters (got ${#val})."
            fi
            if [[ "$val" == *"'"* || "$val" == *'"'* || "$val" == *"\\"* ]]; then
                fail "Brand name must not contain quotes or backslashes."
            fi
            config_set brand_name "$val"
            ok "Brand name set: $val"
            reapply_active
            ;;
        set-logo)
            require_root
            val="${2:-}"
            if [[ -z "$val" ]]; then
                echo -ne "  Path to brand logo (png/jpeg/webp/gif): "
                read -r val
            fi
            [[ -n "$val" && -f "$val" ]] || fail "Logo file not found: ${val:-<empty>}"
            local size mime b64
            size="$(stat -c%s "$val" 2>/dev/null || wc -c < "$val")"
            if [[ "$size" -gt 1048576 ]]; then
                warn "Logo is ${size} bytes (>1 MiB). Consider resizing; storing anyway."
            fi
            case "${val##*.}" in
                jpg|jpeg) mime="image/jpeg" ;;
                png) mime="image/png" ;;
                webp) mime="image/webp" ;;
                gif) mime="image/gif" ;;
                svg) fail "SVG logos are not allowed (PNG/JPEG/GIF/WebP only)." ;;
                *) fail "Unsupported logo type: .${val##*.} (PNG/JPEG/GIF/WebP only)." ;;
            esac
            b64="$(base64 -w0 < "$val" 2>/dev/null || base64 < "$val" | tr -d '\r\n')"
            config_set brand_logo "data:$mime;base64,$b64"
            ok "Brand logo stored (${size} bytes)."
            reapply_active
            ;;
        clear)
            require_root
            config_set brand_name ""
            config_set brand_logo ""
            ok "Brand branding cleared."
            reapply_active
            ;;
        *)
            echo -e "${YELLOW}Usage: nucsub brand {get|set <name>|set-logo <file>|clear}${NC}"
            ;;
    esac
}

brand_menu() {
    while true; do
