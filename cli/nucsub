# --------------------------------------------------------------- Telegram cmd ---
reapply_tg() {  # re-inject the telegram channel into the currently active theme
    local cur
    if [[ "$PANEL" == "pasarguard" ]]; then
        cur="$(pg_current_theme)"
        [[ -n "$cur" && -f "$PG_THEMES_DIR/$cur.html" ]] || return 0
        cp -f "$PG_THEMES_DIR/$cur.html" "$PG_TEMPLATES_DIR/$cur.html"
        pg_inject_tg "$PG_TEMPLATES_DIR/$cur.html"
        return 0
    fi
    cur="$(basename "$(current_theme_dir 2>/dev/null)" 2>/dev/null || true)"
    [[ -n "$cur" && -f "$THEMES_DIR/$cur/index.html" ]] || return 0
    inject_tg "$THEMES_DIR/$cur/index.html" "$DEPLOY_DIR/$cur/index.html"
}

cmd_telegram() {
    local action="${1:-get}"
    local val
    case "$action" in
        get|show)
            val="$(config_get telegram_channel)"
            if [[ -n "$val" ]]; then echo "$val"
            else warn "No Telegram channel set."; fi
            ;;
        set)
            require_root
            val="${2:-}"
            if [[ -z "$val" ]]; then
                echo -ne "  Telegram channel URL (https://t.me/...): "
                read -r val
            fi
            [[ -z "$val" ]] && die "No URL provided."
            if [[ ! "$val" =~ ^https://t\.me/[A-Za-z0-9_]{5,}$ ]]; then
                die "Invalid Telegram URL — expected: https://t.me/username"
            fi
            config_set telegram_channel "$val"
            ok "Telegram channel set: $val"
            reapply_tg
            ;;
        clear|unset)
            require_root
            config_set telegram_channel ""
            ok "Telegram channel cleared."
            reapply_tg
            ;;
        *)
            echo -e "${YELLOW}Usage: nucsub telegram {get|set <url>|clear}${NC}"
            ;;
    esac
}

# --------------------------------------------------- Pasarguard credentials ---
cmd_pglogin() {
    require_root
    local user pass url
    echo -ne "  Pasarguard API URL [https://127.0.0.1:8000]: "
    read -r url
    [[ -z "$url" ]] && url="https://127.0.0.1:8000"
    echo -ne "  Pasarguard admin username [admin]: "
    read -r user
    [[ -z "$user" ]] && user="admin"
    echo -ne "  Pasarguard admin password: "
    read -rs pass; echo
    [[ -n "$pass" ]] || die "Password empty."
    config_set pg_api_url "$url"
    pg_creds_store "$user" "$pass"
    ok "Pasarguard credentials stored ($url)."
}

# ----------------------------------------------------------- Update / Uninstall ---
cmd_update() {
    require_root
    title "Update NUC-SUB"; sep
    local force=0
    [[ "${1:-}" == "-f" || "${1:-}" == "--force" ]] && force=1
    local tmp
    tmp="$(mktemp)"
    info "Fetching latest nucsub from GitHub..."
    if ! curl -fsSL -m 40 "$REPO_URL/cli/nucsub" -o "$tmp"; then
        warn "Could not fetch latest nucsub."
        rm -f "$tmp"; return 1
    fi
    local local_ver remote_ver
    remote_ver="$(sed -n 's/^NUC_SUB_VERSION="\([^"]*\)".*/\1/p' "$tmp" | head -n 1)"
    local_ver="$(sed -n 's/^NUC_SUB_VERSION="\([^"]*\)".*/\1/p' "$INSTALL_DIR/cli/nucsub" | head -n 1)"
    if [[ "$force" -eq 0 && "$remote_ver" == "$local_ver" ]] && cmp -s "$tmp" "$INSTALL_DIR/cli/nucsub"; then
        ok "Already up to date (v$local_ver)."
        rm -f "$tmp"; return 0
    fi
    info "Updating: v${local_ver:-?} → v${remote_ver:-?}"
    install -m 755 "$tmp" "$INSTALL_DIR/cli/nucsub"
    chmod +x "$INSTALL_DIR/cli/nucsub"
    ln -sf "$INSTALL_DIR/cli/nucsub" /usr/bin/nucsub
    local ish="$INSTALL_DIR/install.sh"
    curl -fsSL -m 40 "$REPO_URL/install.sh" -o "$ish" || true
    if [[ -f "$ish" ]]; then
        info "Refreshing web panel assets + all themes..."
        XUI_SUB_NONINTERACTIVE=1 NUC_SUB_PANEL="$PANEL" SKIP_MENU=1 bash "$ish" </dev/null 2>&1 | tail -n 8 || true
    fi
    rm -f "$tmp"
    ok "Update complete — now NUC-SUB v${remote_ver:-latest}."
}

cmd_uninstall() {
    require_root
    title "Uninstall NUC-SUB"; sep
    warn "This will remove:"
    echo -e "  ${DIM}• $INSTALL_DIR (themes, web panel, CLI)${NC}"
    echo -e "  ${DIM}• /usr/bin/nucsub binary${NC}"
    echo -e "  ${DIM}• systemd service: $WEB_SERVICE${NC}"
    echo -e "  ${DIM}• deployed themes in $DEPLOY_DIR${NC}"
    if [[ "$PANEL" == "pasarguard" ]]; then
        echo -e "  ${DIM}• Pasarguard templates ($PG_TEMPLATES_DIR) and admin sub_template${NC}"
    else
        echo -e "  ${RED}• subThemeDir in panel DB (panel returns to default)${NC}"
    fi
    echo ""
    read -rp "  Type 'YES' to confirm: " confirm
    [[ "$confirm" != "YES" ]] && { info "Cancelled."; return 1; }

    # Pasarguard: bring the panel back to its default page BEFORE deleting the
    # files, otherwise the last applied theme keeps rendering after uninstall.
    if [[ "$PANEL" == "pasarguard" ]]; then
        info "Restoring Pasarguard default subscription page..."
        pg_sync "__builtin__" || true
        pg_env_apply "__builtin__" || true
        pg_restart_panel || true
        rm -rf "$PG_TEMPLATES_DIR"
        warn "Removed Pasarguard custom templates ($PG_TEMPLATES_DIR)."
    fi

    systemctl stop "$WEB_SERVICE" 2>/dev/null || true
    systemctl disable "$WEB_SERVICE" 2>/dev/null || true
    rm -f "/etc/systemd/system/$WEB_SERVICE.service"
    systemctl daemon-reload
    pkill -f "python3.*server.py.*--port" 2>/dev/null || true

    rm -f /usr/bin/nucsub
    rm -rf "$INSTALL_DIR"
    rm -rf "$DEPLOY_DIR"
    rm -rf /root/nucsub-src

    if [[ "$PANEL" == "3xui" ]]; then
        db_set_subthemedir ""
        if systemctl list-unit-files "$XUI_SERVICE.service" >/dev/null 2>&1; then
            systemctl restart "$XUI_SERVICE" >/dev/null 2>&1 || true
        fi
    fi
    ok "Uninstalled completely."
}

# ----------------------------------------------------------- Interactive Menu ---
cmd_menu() {
    [[ "$PANEL" == "3xui" ]] && find_sqlite
    while true; do
        draw_menu
        read -r choice
        case "$choice" in
            1) clear; cmd_apply; pause_enter ;;
            2) clear; cmd_reset; pause_enter ;;
            3) clear; cmd_remove; pause_enter ;;
            4) clear; web_panel_menu ;;
            5) clear; cmd_update; pause_enter ;;
            6)
                clear
                if cmd_uninstall; then
                    echo ""
                    echo -e "${DIM}  NUC-SUB removed. Goodbye!${NC}\n"
                    exit 0
                fi
                pause_enter
                ;;
            7) clear; cmd_status; pause_enter ;;
            0) echo -e "\n${DIM}Goodbye!${NC}\n"; exit 0 ;;
            *) warn "Invalid option: $choice"; sleep 1 ;;
        esac
    done
}

# --------------------------------------------------------------------- main ---
cmd="${1:-menu}"; shift || true
[[ "$PANEL" == "3xui" ]] && find_sqlite

case "$cmd" in
    list|ls)        cmd_list ;;
    apply)          cmd_apply "$@" ;;
    download|dl)    cmd_download "$@" ;;
    reset)          cmd_reset ;;
    remove|rm)      cmd_remove "$@" ;;
    status)         cmd_status ;;
    webpanel)       cmd_webpanel "$@" ;;
    telegram)       cmd_telegram "$@" ;;
    pglogin)        cmd_pglogin ;;
    pg-diagnose|diagnose) cmd_pg_diagnose ;;
    update)         cmd_update "$@" ;;
    uninstall)      cmd_uninstall ;;
    menu)           cmd_menu ;;
    version|-v|--version|-V)     echo "nucsub $NUC_SUB_VERSION — NUC-SUB" ;;
    help|-h|--help|"")
        cat <<'EOF'
nucsub — NUC-SUB Subscription theme engine for 3x-ui and Pasarguard panels

Usage:
  nucsub [command] [args...]

Panel:
  Detected automatically (3x-ui via subThemeDir, Pasarguard via SUBSCRIPTION_PAGE_TEMPLATE).

Commands:
  list                List themes (downloaded / not downloaded)
  download <theme>    Download a theme on demand (without applying it)
  apply <theme>       Download (if needed) + activate a theme
  reset               Back to panel default (clear subThemeDir)
  remove <theme>      Remove a theme completely
  status              Show panel DB info, paths, and theme list
  webpanel {start|stop|restart|status|token}
                      Control the web management panel
  telegram {get|set <url>|clear}
                      View or configure the Telegram channel shown in themes
  pglogin             Store Pasarguard panel API credentials (for theme switching)
  pg-diagnose         Print the Pasarguard template resolution chain (fixes a 500)
  update              Pull latest from GitHub and reinstall
  uninstall           Remove everything (themes, CLI, web panel, DB entry)
  menu                Interactive menu (default when no args given)
  version             Show version
  help                Show this help

Interactive mode: run `nucsub` or `nucsub menu`
Web panel:        nucsub webpanel {start|stop|restart|status|token}

Requires: root, bash >= 4; sqlite3 (3x-ui), python3 + curl (Pasarguard API)
EOF
        ;;
    *) echo -e "${RED}Unknown command: $cmd${NC}"; echo "Run: nucsub help"; exit 1 ;;
esac