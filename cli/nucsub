#!/usr/bin/env bash
# =============================================================================
#  nucsub — NUC-SUB Subscription theme engine for 3x-ui and Pasarguard
#  Manage custom subscription page themes directly from the command line.
#  Interactive menu mode: run `nucsub` or `nucsub menu`
# =============================================================================
set -euo pipefail

# ------------------------------------------------------------------ config ---
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; NC='\033[0m'
BOLD='\033[1m'; DIM='\033[2m'

INSTALL_DIR="${SUB_TEMPLATES_DIR:-/opt/nuc-sub}"
REPO_URL="${NUC_SUB_REPO:-https://raw.githubusercontent.com/nuctereadev/NUC-SUB/main}"
THEMES_DIR="$INSTALL_DIR/themes"
DEPLOY_DIR="/etc/x-ui/sub_templates"
XUI_DB="$([ -f /etc/x-ui/x-ui.db ] && echo /etc/x-ui/x-ui.db || echo /etc/3x-ui/db/x-ui.db)"
XUI_SERVICE="x-ui"
SUB_THEME_KEY="subThemeDir"
WEB_BASE="$INSTALL_DIR/webpanel"
WEB_SERVICE="xui-sub-panel"
WEB_PORT_FILE="$INSTALL_DIR/.webport"
WEB_TOKEN_FILE="$INSTALL_DIR/.webpanel-token"
CONFIG_FILE="$INSTALL_DIR/config.json"
PANEL_CONF="$INSTALL_DIR/panel.conf"

# Every theme known to the project (used to offer on-demand downloads).
XUI_THEMES=(minimal gradient matrix glass neon sunset arctic cyberpunk)
PG_THEMES=(gradient minimal glass sunset matrix neon arctic cyberpunk)

# ------------------------------------------------------- panel detection -------
# nucsub supports two panels: 3x-ui (sqlite subThemeDir) and Pasarguard
# (Jinja2 subscription/ templates driven by the panel .env). The panel is
# remembered by the installer in $PANEL_CONF, else auto-detected on disk.
PANEL=""
detect_panel() {
    local conf=""
    [[ -f "$PANEL_CONF" ]] && conf="$(tr -d '[:space:]' < "$PANEL_CONF")"
    case "$conf" in
        3xui|pasarguard) PANEL="$conf"; return 0 ;;
    esac
    local p
    for p in /etc/x-ui/x-ui.db /etc/3x-ui/db/x-ui.db; do
        [[ -f "$p" ]] && { PANEL="3xui"; return 0; }
    done
    if [[ -d /var/lib/pasarguard ]] || [[ -d /opt/pasarguard ]]; then
        PANEL="pasarguard"; return 0
    fi
    PANEL="3xui"
}
detect_panel

# Pasarguard paths (only used when PANEL == "pasarguard")
PG_TEMPLATES_DIR="${PASARGUARD_TEMPLATES_DIR:-/var/lib/pasarguard/templates/subscription}"
PG_THEMES_DIR="$INSTALL_DIR/pasarguard-themes/subscription"
PG_ENV_FILE="${PASARGUARD_ENV:-}"
if [[ -z "$PG_ENV_FILE" ]]; then
    for _pgd in /opt/pasarguard /var/lib/pasarguard /root/pasarguard /etc/pasarguard /data/pasarguard; do
        [[ -f "$_pgd/.env" ]] && { PG_ENV_FILE="$_pgd/.env"; break; }
    done
fi
unset _pgd

# ------------------------------------------------------------------ helpers ---
die() { echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
ok()  { echo -e "${GREEN}✓ $*${NC}"; }
info(){ echo -e "${BLUE}ℹ $*${NC}"; }
warn(){ echo -e "${YELLOW}⚠ $*${NC}"; }
title(){ echo -e "\n${BOLD}${CYAN}$*${NC}"; }
sep(){ echo -e "${DIM}──────────────────────────────────────────────${NC}"; }

require_root() { [[ "$EUID" -eq 0 ]] || die "Please run as root (sudo)."; }

# Validate a theme name is a bare safe identifier — no slashes, dots, or shell/SQL metacharacters.
valid_theme_name() {
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]
}

find_sqlite() {
    if command -v sqlite3 >/dev/null 2>&1; then _SQLITE="sqlite3"; return 0; fi
    warn "sqlite3 not found — install with: apt install -y sqlite3"
    _SQLITE=""
}

# ---------------------------------------------------------------- config.json ---
config_get() {
    local key="${1:-}"
    [[ -z "$key" || ! -f "$CONFIG_FILE" ]] && { echo ""; return 0; }
    python3 -c "
import json,sys
d=json.load(open('$CONFIG_FILE'))
print(d.get('$key',''))
" 2>/dev/null || echo ""
}

config_set() {
    local key="${1:-}" val="${2:-}"
    [[ -z "$key" ]] && die "config_set: missing key"
    mkdir -p "$(dirname "$CONFIG_FILE")"
    if [[ -f "$CONFIG_FILE" ]]; then
        python3 -c "
import json
d=json.load(open('$CONFIG_FILE'))
d['$key']='$val'
json.dump(d,open('$CONFIG_FILE','w'),indent=2,ensure_ascii=False)
" 2>/dev/null || echo "{\"$key\":\"$val\"}" > "$CONFIG_FILE"
    else
        echo "{\"$key\":\"$val\"}" > "$CONFIG_FILE"
    fi
    chmod 600 "$CONFIG_FILE"
}

find_free_port() {
    local start="${1:-8080}" end="${2:-9999}"
    for ((p=start; p<end; p++)); do
        if ! ss -tlnp 2>/dev/null | grep -q ":${p} " && \
           ! python3 -c "import socket; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); s.bind(('0.0.0.0',$p)); s.close()" 2>/dev/null; then
            echo "$p"; return 0
        fi
    done
    echo "$start"
}

db_set_subthemedir() {
    local val="$1"
    if [[ -n "${_SQLITE}" ]]; then
        [[ -e "$XUI_DB" ]] || die "x-ui database not found: $XUI_DB"
        # escape single quotes to prevent SQL injection through values
        local vesc
        vesc="${val//\'/\'\'}"
        sqlite3 "$XUI_DB" "DELETE FROM settings WHERE key='$SUB_THEME_KEY';"
        # NOTE: must use an explicit if + trailing return so an empty value
        # does not make this function exit non-zero under `set -euo pipefail`.
        if [[ -n "$val" ]]; then
            sqlite3 "$XUI_DB" "INSERT INTO settings (key,value) VALUES ('$SUB_THEME_KEY','$vesc');"
        fi
        return 0
    else die "sqlite3 required."; fi
}

db_get_subthemedir() {
    if [[ -n "${_SQLITE}" && -e "$XUI_DB" ]]; then
        sqlite3 "$XUI_DB" "SELECT value FROM settings WHERE key='$SUB_THEME_KEY' ORDER BY id LIMIT 1;" 2>/dev/null || true
    else echo ""; fi
}

db_panel_info() {
    if [[ -n "${_SQLITE}" && -e "$XUI_DB" ]]; then
        sqlite3 "$XUI_DB" "SELECT key||'='||value FROM settings WHERE key IN ('webPort','webBasePath','panelGuid','secret','webCertFile','webKeyFile') ORDER BY key;" 2>/dev/null || true
    fi
}

current_theme_dir() {
    if [[ "$PANEL" == "pasarguard" ]]; then pg_current_theme; else db_get_subthemedir; fi
}

list_theme_folders() {
    if [[ "$PANEL" == "pasarguard" ]]; then
        [[ -d "$PG_THEMES_DIR" ]] || return 0
        find "$PG_THEMES_DIR" -maxdepth 1 -type f -name '*.html' -exec basename {} .html \; 2>/dev/null | sort
    else
        [[ -d "$THEMES_DIR" ]] || return 0
        find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2>/dev/null | sort
    fi
}

# All themes the project ships, regardless of whether they are on disk yet.
available_themes() {
    if [[ "$PANEL" == "pasarguard" ]]; then
        printf '%s\n' "${PG_THEMES[@]}"
    else
        printf '%s\n' "${XUI_THEMES[@]}"
    fi
}

# On-demand download from the repo into the local themes source dir.
download_theme() {  # download_theme <name>
    local name="${1:-}"
    valid_theme_name "$name" || return 1
    if [[ "$PANEL" == "pasarguard" ]]; then
        local dst="$PG_THEMES_DIR/$name.html"
        [[ -f "$dst" ]] && return 0
        mkdir -p "$PG_THEMES_DIR"
        curl -fsSL -m 60 "$REPO_URL/pasarguard-themes/subscription/$name.html" -o "$dst" || return 1
        ok "Theme '$name' downloaded."
    else
        local td="$THEMES_DIR/$name"
        [[ -d "$td" ]] && return 0
        mkdir -p "$td/css" "$td/fonts" "$td/fa"
        curl -fsSL -m 60 "$REPO_URL/themes/$name/index.html" -o "$td/index.html" || return 1
        curl -fsSL -m 60 "$REPO_URL/themes/$name/css/icons.css" -o "$td/css/icons.css" || return 1
        curl -fsSL -m 60 "$REPO_URL/themes/$name/css/fonts.css" -o "$td/css/fonts.css" || return 1
        curl -fsSL -m 60 "$REPO_URL/themes/$name/fonts/IRANSansX-Bold.woff2" -o "$td/fonts/IRANSansX-Bold.woff2" || return 1
        curl -fsSL -m 60 "$REPO_URL/themes/$name/fonts/IRANSansX-Regular.woff2" -o "$td/fonts/IRANSansX-Regular.woff2" || return 1
        curl -fsSL -m 60 "$REPO_URL/themes/$name/fa/fa-solid-900.woff2" -o "$td/fa/fa-solid-900.woff2" || return 1
        ok "Theme '$name' downloaded."
    fi
    return 0
}

theme_is_runnable() {
    local name="$1"
    if [[ "$PANEL" == "pasarguard" ]]; then
        [[ -f "$PG_THEMES_DIR/$name.html" ]]
    else
        [[ -f "$THEMES_DIR/$name/index.html" ]] || [[ -f "$THEMES_DIR/$name/sub.html" ]]
    fi
}

db_get_subid() {
    if [[ -n "${_SQLITE}" && -e "$XUI_DB" ]]; then
        sqlite3 "$XUI_DB" "SELECT sub_id FROM clients WHERE enable=1 LIMIT 1;" 2>/dev/null || true
    fi
}

db_panel_setting() {
    local key="$1"
    if [[ -n "${_SQLITE}" && -e "$XUI_DB" ]]; then
        sqlite3 "$XUI_DB" "SELECT value FROM settings WHERE key='$key' ORDER BY id LIMIT 1;" 2>/dev/null || true
    fi
}

sub_url_for_sid() {
    local sid="$1"; [[ -z "$sid" ]] && { echo ""; return 0; }
    local webport webbase
    webport="$(db_panel_setting webPort)"; webbase="$(db_panel_setting webBasePath)"
    local host="${SUB_PANEL_HOST:-127.0.0.1}"; local port="${webport:-2096}"
    # 0.0.0.0 is a bind address, not a valid destination for outbound connections
    [[ "$host" == "0.0.0.0" ]] && host="127.0.0.1"
    if [[ -n "$webbase" && "$webbase" != "/" ]]; then echo "http://$host:$port/${webbase#/}/sub/$sid"
    else echo "http://$host:$port/sub/$sid"; fi
}

# ----------------------------------------------------------- Pasarguard panel ---
# Commands in this section only apply when PANEL == "pasarguard".
# The active template is stored as SUBSCRIPTION_PAGE_TEMPLATE in the panel .env
# (e.g. `subscription/gradient.html`); themes are self-contained Jinja2 files in
# /var/lib/pasarguard/templates/subscription/.

pg_current_theme() {
    [[ -n "$PG_ENV_FILE" && -f "$PG_ENV_FILE" ]] || { echo ""; return 0; }
    local v
    v="$(sed -n 's/^SUBSCRIPTION_PAGE_TEMPLATE=[^#]*subscription\/\([^"]*\)".*/\1/p' "$PG_ENV_FILE" | tail -n 1)"
    # "subscription/index.html" is the panel's built-in page → not a custom theme
    [[ "$v" == "index.html" ]] && v=""
    [[ -n "$v" ]] && echo "${v%.html}" || echo ""
}

pg_app_container() {
    local names line c
    names="$(docker ps --format '{{.Names}}\t{{.Image}}' 2>/dev/null)"
    [[ -z "$names" ]] && { echo ""; return 0; }
    # prefer a pasarguard container that is NOT a supporting service
    c="$(printf '%s\n' "$names" | grep -i 'pasarguard' \
        | grep -ivE 'pgadmin|pgbouncer|timescaledb|postgres|redis|node|traefik|caddy|nginx|worker' \
        | head -n 1 | cut -f1)"
    [[ -n "$c" ]] && { echo "$c"; return 0; }
    # fallback: any container tagged/related to pasarguard
    c="$(printf '%s\n' "$names" | grep -iE 'pasarguard' | head -n 1 | cut -f1)"
    echo "$c"
}

pg_restart_panel() {
    # Applies .env changes reliably: try compose first (recreates the app
    # container with the new env), then force a container restart so every
    # deployment style picks the change up. Returns 0 only when something ran.
    local dir="" c="" restarted=""
    for _pgd in /opt/pasarguard /var/lib/pasarguard /root/pasarguard; do
        [[ -f "$_pgd/docker-compose.yml" || -f "$_pgd/docker-compose.yaml" ]] && { dir="$_pgd"; break; }
    done
    if [[ -n "$dir" ]] && command -v docker >/dev/null 2>&1; then
        ( cd "$dir" && docker compose up -d ) >/dev/null 2>&1 \
            || ( cd "$dir" && docker-compose up -d ) >/dev/null 2>&1 \
            || true
    fi
    if command -v docker >/dev/null 2>&1; then
        c="$(pg_app_container)"
        if [[ -n "$c" ]]; then
            docker restart "$c" >/dev/null 2>&1 && restarted=1 || true
        fi
    fi
    if [[ -z "$restarted" ]]; then
        systemctl restart pasarguard >/dev/null 2>&1 && restarted=1 || true
    fi
    unset _pgd
    [[ -n "$restarted" ]]
}

pg_env_apply() {  # pg_env_apply <theme-name | __builtin__ | "">
    local name="${1:-}"
    [[ -n "$PG_ENV_FILE" && -f "$PG_ENV_FILE" ]] || return 1
    local tmpl
    if [[ "$name" == "__builtin__" ]]; then
        # The panel requires a valid template at all times: an empty value
        # raises "TemplateNotFound ''. "subscription/index.html" resolves to the
        # panel's own built-in page (shipped in app/templates).
        tmpl='SUBSCRIPTION_PAGE_TEMPLATE="subscription/index.html"'
    elif [[ -n "$name" ]]; then
        tmpl="SUBSCRIPTION_PAGE_TEMPLATE=\"subscription/$name.html\""
    else
        tmpl="SUBSCRIPTION_PAGE_TEMPLATE=\"\""
    fi
    python3 - "$PG_ENV_FILE" "$tmpl" <<'PY'
import sys
p, val = sys.argv[1], sys.argv[2]
lines = open(p, encoding='utf-8').read().splitlines()
out = []
done_tpl = done_dir = False
for l in lines:
    s = l.strip()
    if (s.startswith('SUBSCRIPTION_PAGE_TEMPLATE')
            or (l.lstrip().startswith('#') and l.lstrip('#').strip().startswith('SUBSCRIPTION_PAGE_TEMPLATE'))):
        out.append(val); done_tpl = True; continue
    if (s.startswith('CUSTOM_TEMPLATES_DIRECTORY')
            or (l.lstrip().startswith('#') and l.lstrip('#').strip().startswith('CUSTOM_TEMPLATES_DIRECTORY'))):
        out.append('CUSTOM_TEMPLATES_DIRECTORY="/var/lib/pasarguard/templates/"'); done_dir = True; continue
    out.append(l)
if not done_tpl:
    out.append(val)
if not done_dir:
    out.append('CUSTOM_TEMPLATES_DIRECTORY="/var/lib/pasarguard/templates/"')
open(p, 'w', encoding='utf-8').write('\n'.join(out) + '\n')
PY
}

# --- Pasarguard panel template sync (no interactive credentials needed) -------
# The panel shows the admin's own sub_template when set. apply/reset/uninstall
# must sync every admin's sub_template so switching actually takes effect.
# Prefer the direct DB (self-contained, no prompts); fall back to the HTTP API
# only when credentials are already stored in config.json.

PG_CREDS_USER=""; PG_CREDS_PASS=""

pg_inject_tg() {  # pg_inject_tg <deployed-file> — fill the @@TG_CHANNEL@@ slot
    local f="$1" tg
    tg="$(config_get telegram_channel)"
    [[ -f "$f" ]] || return 1
    python3 - "$f" "$tg" <<'PY'
import sys
p, chan = sys.argv[1], sys.argv[2]
s = open(p, encoding='utf-8').read()
if '@@TG_CHANNEL@@' in s:
    open(p, 'w', encoding='utf-8').write(s.replace('@@TG_CHANNEL@@', chan))
PY
}

pg_env_value() {  # pg_env_value <KEY> — read a value from the panel .env
    [[ -n "$PG_ENV_FILE" && -f "$PG_ENV_FILE" ]] || return 1
    grep -E "^${1}=" "$PG_ENV_FILE" | head -n 1 | cut -d= -f2- | tr -d '"' | tr -d "'"
}

pg_db_conn() {
    local dbc dbname dbuser dbpass
    dbc="$(docker ps --format '{{.Names}}' 2>/dev/null | grep -i timescale | head -n 1)"
    [[ -n "$dbc" ]] || return 1
    dbname="$(pg_env_value DB_NAME)"; dbuser="$(pg_env_value DB_USER)"; dbpass="$(pg_env_value DB_PASSWORD)"
    [[ -n "$dbname" && -n "$dbuser" && -n "$dbpass" ]] || return 1
    PG_DB_CONTAINER="$dbc"; PG_DB_NAME="$dbname"; PG_DB_USER="$dbuser"; PG_DB_PASS="$dbpass"
    return 0
}

pg_db_set_subtemplate() {  # pg_db_set_subtemplate <value, e.g. subscription/glass.html or "">
    local val="${1:-}" out
    pg_db_conn || return 1
    # value is validated/sanitized by callers (theme names are [A-Za-z0-9_-].html)
    out="$(docker exec -e "PGPASSWORD=$PG_DB_PASS" "$PG_DB_CONTAINER" \
        psql -U "$PG_DB_USER" -d "$PG_DB_NAME" -v ON_ERROR_STOP=1 -tAc \
        "UPDATE admins SET sub_template='$(printf %s "$val" | tr -cd 'A-Za-z0-9./_-' )' RETURNING id;" 2>&1)"
    [[ -n "${out:-}" ]]
}

pg_creds_present() {  # stored/ env creds available (no prompting — ever)
    PG_CREDS_USER="${PG_ADMIN_USER:-}"
    PG_CREDS_PASS="${PG_ADMIN_PASS:-}"
    [[ -z "$PG_CREDS_USER" ]] && PG_CREDS_USER="$(config_get pg_admin_user)"
    [[ -z "$PG_CREDS_PASS" ]] && PG_CREDS_PASS="$(config_get pg_admin_pass)"
    [[ -n "$PG_CREDS_USER" && -n "$PG_CREDS_PASS" ]]
}

pg_creds_store() {  # pg_creds_store <user> <pass> — optional (used by `pglogin`)
    config_set pg_admin_user "$1"
    config_set pg_admin_pass "$2"
}

pg_api_base() {
    local u
    u="$(config_get pg_api_url)"
    [[ -n "$u" ]] && { echo "$u"; return 0; }
    echo "${PASARGUARD_API:-https://127.0.0.1:8000}"
}

pg_api_token() {
    local base user pass
    base="$(pg_api_base)"
    user="$PG_CREDS_USER"; pass="$PG_CREDS_PASS"
    curl -sk -m 20 -X POST "$base/api/admin/token" \
        -H 'Content-Type: application/x-www-form-urlencoded' \
        --data-urlencode "grant_type=password" \
        --data-urlencode "username=$user" \
        --data-urlencode "password=$pass" \
        | python3 -c 'import sys,json
try:
    print(json.load(sys.stdin).get("access_token",""))
except Exception:
    print("")'
}

pg_admin_set_all() {  # pg_admin_set_all <JSON value, e.g. "\"subscription/glass.html\"" or "\"\"">
    local val="${1:-}" base token admins admin r ok=0
    base="$(pg_api_base)"
    token="$(pg_api_token)"
    [[ -n "$token" ]] || { warn "Panel API login failed — check admin credentials."; return 1; }
    admins="$(curl -sk -m 20 -H "Authorization: Bearer $token" "$base/api/admins" 2>/dev/null \
        | python3 -c 'import sys,json
try:
    d=json.load(sys.stdin)
    items=d.get("admins", d) if isinstance(d,dict) else d
    for a in items:
        if isinstance(a,dict) and a.get("username"):
            print(a["username"])
except Exception:
    pass')"
    [[ -n "$admins" ]] || { warn "No admins found via panel API."; return 1; }
    while IFS= read -r admin; do
        [[ -z "$admin" ]] && continue
        r="$(curl -sk -m 20 -X PUT "$base/api/admin/$(printf %s "$admin" | tr -cd 'A-Za-z0-9_.-' )" \
            -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
            -d "{\"sub_template\":$val}" -o /dev/null -w '%{http_code}' 2>/dev/null)"
        [[ "$r" == "200" ]] && ok=$((ok+1))
    done <<< "$admins"
    if [[ $ok -gt 0 ]]; then
        info "Per-admin sub_template set on $ok admin(s): $val"
        return 0
    fi
    warn "Could not update any admin sub_template via API."
    return 1
}

pg_sync() {  # pg_sync <theme-name | __builtin__ | ""> — sync every admin's sub_template
    # Self-contained (DB) or stored-API credentials; NEVER prompts the user.
    local name="${1:-}" val=""
    if [[ -n "$name" && "$name" != "__builtin__" ]]; then
        val="subscription/$name.html"
    fi
    # 1) direct DB
    if pg_db_set_subtemplate "$val"; then
        info "Template set on every admin (DB): '${val:-<built-in>}'"
        return 0
    fi
    # 2) stored/ env API credentials (only when already available)
    if pg_creds_present; then
        local tries=0
        while [[ $tries -lt 3 ]]; do
            [[ -n "$(pg_api_token)" ]] && { pg_admin_set_all "\"$val\""; return $?; }
            tries=$((tries+1)); sleep 2
        done
        warn "Panel API unreachable."
        return 1
    fi
    # 3) give up quietly — caller falls back to .env + restart
    warn "Could not update every admin via DB/API — falling back to the .env default."
    return 1
}

