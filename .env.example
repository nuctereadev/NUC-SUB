# --- NUC-SUB dual-panel installer (install.sh) ---
# Selected panel: 3xui | pasarguard (prompted interactively by default)
NUC_SUB_PANEL=3xui

# Install directory on the server (default /opt/nuc-sub)
# XUI_SUB_INSTALL_DIR=/opt/nuc-sub

# Skip prompts entirely (auto-detect panel from the installed panel)
# XUI_SUB_NONINTERACTIVE=1

# --- Legacy Node.js dev harness (not part of the product) ---
PORT=3000
XUI_PANEL_URL=https://YOUR-IP:54321
XUI_BASE_PATH=YOUR_PANEL_BASE_PATH
XUI_USERNAME=admin
XUI_PASSWORD=password
XUI_SUB_URL=https://YOUR-IP:2096
DEFAULT_TEMPLATE=minimal